#!/usr/bin/env python3
"""Append one entry to an authoritative KDB log with locking and verification.

THE ENTRY IS DATA. It is never parsed, never expanded, never executed by this
script: it is read as bytes and written as bytes, and the tail of the file is
re-read afterwards to prove the bytes that landed are the bytes that were given.

That guarantee stops at this process's argv, and the gap has caused three
incidents in this repo. KDB prose is full of command names, and inside a
DOUBLE-QUOTED bash/zsh argument backticks, $(...) and $VAR are live — the shell
substitutes them before this script is started, so by the time argv arrives the
command has already run and the text is already gone. Two occurrences silently
ate commit-message text; on 2026-07-31 an entry carrying a recreate command in a
markdown code span EXECUTED it against the live fleet, and was caught only
during the docker build-context transfer.

So, in order of preference:

  1. bin/kdb_append <log> --file entry.txt      # nothing is quoted at all
  2. bin/kdb_append <log> - <<'EOF'             # QUOTED heredoc: no expansion
     ...entry...
     EOF
  3. subprocess.run(["bin/kdb_append", log, text])   # argv, no shell
  4. bin/kdb_append <log> 'single quoted'       # safe in sh/bash/zsh, but one
                                                # apostrophe in the prose ends
                                                # the quoting

Never a double-quoted shell argument. An UNquoted <<EOF is the same trap as a
double quote — the delimiter itself has to be quoted (<<'EOF').

Usage:
  kdb_append <log> <entry>        entry as one argv element
  kdb_append <log> -              entry read from stdin
  kdb_append <log> --file PATH    entry read from a file ("-" for stdin)
  kdb_append <log>                entry read from stdin when something is piped
  kdb_append <log> -- -entry      an entry starting with "-"

Exit status is 0 only when the entry was written and verified. An entry that is
missing, empty or whitespace-only is an error, and NOTHING is written.
"""

from __future__ import annotations

import argparse
import fcntl
import os
from pathlib import Path
import sys
from datetime import datetime, timezone


MAX_LOG_BYTES = 5 * 1024 * 1024

# STDIN_ARG is the conventional POSIX spelling for "read it from stdin", and
# supporting it is the whole of defect #1: it used to be taken as the LITERAL
# entry, so `kdb_append <log> - <<'EOF' ... EOF` appended a two-byte "-\n",
# discarded the heredoc, and exited 0. An append-only log cannot be repaired
# afterwards, and exit 0 meant nobody looked.
STDIN_ARG = "-"


class EntryError(Exception):
    """A problem with the entry itself. Nothing has been written."""


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="kdb_append",
        description=(
            "Atomically append text to a KDB *.log file. The entry is inert "
            "text whatever it contains -- this script never runs a shell. Pass "
            "it with --file or a quoted heredoc; a DOUBLE-quoted shell argument "
            "lets the calling shell execute backticks and $(...) inside your "
            "prose before this script ever sees it."
        ),
    )
    parser.add_argument("target", help="KDB log path, for example kdb/session.log")
    parser.add_argument(
        "entry",
        nargs="?",
        help=(
            "Entry text as a single argument, or '-' to read it from stdin. "
            "Omitted with something piped in also reads stdin. Use '--' before "
            "an entry that starts with a dash."
        ),
    )
    parser.add_argument(
        "--file",
        "-f",
        dest="file",
        metavar="PATH",
        help=(
            "Read the entry from PATH ('-' for stdin). The safest form: the "
            "text never passes through a shell, so nothing in it can be quoted "
            "wrong."
        ),
    )
    return parser.parse_args(argv)


def resolve_target(path_text: str) -> Path:
    target = Path(path_text)
    if target.suffix != ".log":
        raise ValueError("KDB append target must be a *.log file")

    parts = target.parts
    if "kdb" not in parts:
        raise ValueError("KDB append target must be under the kdb directory")

    return target


def read_entry(args: argparse.Namespace, stdin=None) -> str:
    """Return the entry text, or raise EntryError.

    Exactly ONE source, with no precedence rule: --file together with a
    positional entry is a refusal, not a silent winner. A precedence would mean
    a caller that supplied both got one of them written and never learned
    which, on a log that cannot be edited afterwards.
    """
    if stdin is None:
        stdin = sys.stdin

    from_file = args.file is not None
    from_argv = args.entry is not None and args.entry != STDIN_ARG
    if from_file and args.entry is not None:
        raise EntryError(
            "both --file and a positional entry were given; pass exactly one "
            "(they cannot be merged, and picking one silently would write an "
            "entry the caller never chose)"
        )

    if from_file:
        if args.file == STDIN_ARG:
            entry = stdin.read()
            source = "stdin"
        else:
            try:
                entry = Path(args.file).read_text(encoding="utf-8")
            except OSError as exc:
                raise EntryError(f"reading the entry from {args.file}: {exc}") from exc
            source = args.file
    elif from_argv:
        entry = args.entry
        source = "the command line"
    else:
        # Either an explicit "-" or nothing at all. Nothing at all is a stdin
        # read only when something is genuinely piped in: on a terminal that
        # blocked forever with no message, which reads as a hung tool rather
        # than as a missing argument.
        if args.entry != STDIN_ARG and stdin.isatty():
            raise EntryError(
                "no entry given. Pass one as a single argument, as --file PATH, "
                "or on stdin with '-' and a QUOTED heredoc (<<'EOF')"
            )
        entry = stdin.read()
        source = "stdin"

    # An empty entry is an error, never a bare newline appended to an
    # append-only log. This is the second half of defect #1: the shapes it
    # catches (a heredoc that produced nothing, an empty --file, a pipeline
    # whose producer died) are otherwise a silent one-byte write.
    if not entry.strip():
        raise EntryError(
            f"the entry read from {source} is empty; refusing to append a blank "
            "line to an append-only log"
        )
    return entry


def rotate_if_needed(target: Path) -> None:
    if not target.exists() or target.stat().st_size <= MAX_LOG_BYTES:
        return

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
    rotated = target.with_name(f"{target.name}.{stamp}")
    os.replace(target, rotated)
    target.touch(mode=0o644, exist_ok=True)


def append_with_lock(target: Path, entry: str) -> None:
    if not entry.endswith("\n"):
        entry += "\n"
    data = entry.encode("utf-8")

    target.parent.mkdir(parents=True, exist_ok=True)
    lock_path = target.with_suffix(target.suffix + ".lock")

    with open(lock_path, "a", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)

        rotate_if_needed(target)
        # Taken AFTER rotation: a rotated file is a new empty one, so a
        # pre-size captured before the rename would make the no-loss guard
        # below fire on a correct rotation.
        pre_size = target.stat().st_size if target.exists() else 0

        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)

        post_size = target.stat().st_size
        if pre_size > 0 and post_size < pre_size:
            raise RuntimeError(
                f"no-loss guard failed: {target} shrank from {pre_size} to {post_size}"
            )

        # The bytes that landed must be the bytes that were given. This is what
        # makes "the entry is inert text" a checked property rather than a
        # claim: it compares raw bytes, so a backtick, a $(...) or a newline in
        # the prose is verified present exactly as supplied.
        with open(target, "rb") as verify_file:
            verify_file.seek(max(0, post_size - len(data)))
            tail = verify_file.read()
        if tail != data:
            raise RuntimeError(f"durability check failed for {target}")

        fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    try:
        target = resolve_target(args.target)
        entry = read_entry(args)
        append_with_lock(target, entry)
    except Exception as exc:
        print(f"kdb_append: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
