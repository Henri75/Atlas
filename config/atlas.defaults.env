# Atlas — committed configuration. This file is the source of truth.
#
# Precedence, lowest to highest:
#   1. this file                  committed, holds everything non-secret
#   2. Doppler                    secrets only (*_API_KEY), when a session exists
#   3. .env                       optional, gitignored, ABSENT by default
#
# The stack runs correctly with no .env at all — that is the normal state. Create
# one only to override a value on one machine, containing just the lines you are
# changing. Everything else keeps coming from here.
#
# Edit this file, then `make restart-build`. A plain `make restart` will NOT pick
# it up: container environment is fixed when the container is created.
# See docs/configuration.md and docs/superpowers/specs/2026-07-29-configuration-sources-design.md.
#
# Host paths mounted read-only into the stack (compose maps them to /data/*).
CODE_ROOT_HOST=/Users/nasta/__CODING NEW
CLAUDE_PROJECTS_HOST=/Users/nasta/.claude/projects

# Extra project trees to index (up to four). Uncomment and point at any folder
# holding more projects; each is mounted read-only. Apply with
# `make restart-build` after changing these — no reindex flag needed.
#CODE_ROOT_HOST_2=/Users/nasta/Work
#CODE_ROOT_HOST_3=/Volumes/CloudBox/Projects
#CODE_ROOT_HOST_4=
#CODE_ROOT_HOST_5=

# In-container paths (leave as-is when running under compose).
CODE_ROOT=/data/code
CLAUDE_PROJECTS_DIR=/data/claude/projects

# Infrastructure.
DATABASE_URL=postgres://kdbscope:kdbscope@postgres:5432/kdbscope
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
# Where Qdrant's data volume is mounted read-only into the API, so the dashboard
# can report real disk usage — Qdrant exposes no API for it.
QDRANT_STORAGE_PATH=/qdrant-storage

# Indexing.
SCAN_INTERVAL_MIN=5
# Parallel scan jobs. A local Ollama serialises embed requests, so more workers
# only deepen its queue. Raise for a remote/batched embedding endpoint.
WORKER_CONCURRENCY=2
# Kill switch for the sparse re-tokenisation pass (see docs/configuration.md).
# Leave true: a tokeniser change that is not applied to stored vectors makes
# keyword search silently stop matching. Set false only to stop a misbehaving
# rebuild; it retries on the next boot.
KDB_SPARSE_REBUILD=true
# Let EMBEDDINGS_PROVIDER=auto move the index to a new collection after falling
# back to a non-preferred embedder. Leave false: the fallback is a guess, and the
# consequence is a full re-embed plus the old collection being reclaimed.
KDB_ALLOW_EMBEDDER_DOWNGRADE=false

# Embeddings: auto | ollama | bundled | openai | g2p
# 'auto' prefers Ollama (much faster, 768-dim) and pulls the model on first
# boot; it falls back to the bundled CPU model with a warning if Ollama is down.
EMBEDDINGS_PROVIDER=auto
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=
# Secret. Left empty here on purpose: a key belongs in Doppler, which overrides
# this file. Only needed for a keyed endpoint (provider=openai); Ollama and the
# local G2P proxy need none.
EMBEDDINGS_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

# Ask-mode LLM: openai | g2p   (g2p = OpenAI-compatible proxy, no key needed)
LLM_PROVIDER=g2p
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=http://host.docker.internal:8181/v1
# Secret — see EMBEDDINGS_API_KEY above. G2P needs no key.
LLM_API_KEY=

# Doc staleness. Query-time ranking only: changing either never needs a reindex.
# Months since a doc's mtime past which it is labelled `aging` (no rank penalty —
# an old runbook that simply never needed edits must not be buried).
KDB_DOCS_AGING_MONTHS=12
# Score multiplier for docs under archive-style paths (0-1; lower buries deeper).
KDB_ARCHIVED_PENALTY=0.6

# Caller identity sent to G2P as `X-G2P-Client-Id` on every LLM *and* embedding
# call, so Atlas's token spend is attributed to us in G2P's /hstats instead of
# landing in the anonymous bucket. Telemetry only — it never affects routing —
# and harmless against non-G2P OpenAI-compatible endpoints, which ignore unknown
# X- headers. Unset uses the default below; set it per instance to tell two
# deployments apart; set it explicitly empty to send no header at all.
KDB_G2P_CLIENT_ID=Atlas

# Service ports (host side, 127.0.0.1 only).
API_PORT=8710
MCP_PORT=8711
UI_PORT=8712
QDRANT_PORT=6363
QDRANT_GRPC_PORT=6364
REDIS_PORT=6390
POSTGRES_PORT=5460

# Internal URL the mcp/cli/ui use to reach the API.
KDBSCOPE_API_URL=http://api:8710
